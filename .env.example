# Copy to .env.local when configuring a development integration.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# EVAL-002: set these to the isolated development Supabase project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server-only variables belong in the Cloud secret manager. Never use
# NEXT_PUBLIC_ for privileged keys or place production credentials here.
# SUPABASE_SERVICE_ROLE_KEY=
# PAYMENT_PROVIDER_SERVER_KEY=
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
